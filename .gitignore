# ビルド結果
build/
build-android/

# テストの実行時に作られるファイル (gtest_discover_tests の cmake_test_discovery_*.json など)
log/

# エディタ / IDE の設定
.vscode/
.idea/
*.iml

# Python の仮想環境
.venv

# 学習済みの重み. モデル側のリポジトリ (yoloPokerchip) から受け取る
*.pt

# データセット
# 親ディレクトリが無視されていると中のファイルを ! で戻せないため, 1 段ずつ戻す
testimages/*
!testimages/v2/
testimages/v2/*
!testimages/v2/single_color/
testimages/v2/single_color/*
!testimages/v2/single_color/answers.jsonl
!testimages/v2/single_color/README.md

# tmp
tmp/

# 外部ファイルの取得先とビルド結果 (OpenCV, OpenCV Android SDK, Android NDK).
# scripts/build_opencv.sh と scripts/fetch_android_deps.sh で作り直せる
third_party/

# scripts/export_model.sh で作る ONNX モデル (Android の assets へのコピーも含む)
models/
*.onnx

# Android (Gradle, Kotlin, Android Studio が作るもの)
android/.gradle/
android/.kotlin/
android/local.properties
android/captures/
android/**/build/
android/app/.cxx/
