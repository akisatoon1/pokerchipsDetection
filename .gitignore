# ビルド結果
build/
build-android/
build-wasm/

# エディタ / IDE の設定
.vscode/
.idea/
*.iml

# Python の仮想環境
.venv
.venv-label

# 学習済みの重み. モデル側のリポジトリ (yoloPokerchip) から受け取る
*.pt

# tmp
tmp/

# 研究開発の試作 (Python の実験コードと結果). git の履歴には残さない
research/

# 外部ファイルの取得先とビルド結果 (OpenCV, OpenCV Android SDK, Android NDK, Emscripten, WASM 用の OpenCV).
# scripts/build_opencv.sh, scripts/fetch_android_deps.sh, scripts/fetch_emsdk.sh, scripts/build_opencv_wasm.sh で作り直せる
third_party/

# scripts/export_model.sh で作る, または scripts/fetch_model.sh で取る ONNX モデル (Android の assets へのコピーも含む).
# モデルは重いので git に入れず, GitHub Release に置く. git に入れるのは, どの Release を使うかを書いた models/model.lock だけ.
# models/VERSION は手元の絶対パスを含むので入れない.
models/*
!models/model.lock
*.onnx

# scripts/build_wasm.sh が Web で配る場所に置く WASM とモデル
web/src/client/public/detector/

# Android (Gradle, Kotlin, Android Studio が作るもの)
android/.gradle/
android/.kotlin/
android/local.properties
android/captures/
android/**/build/
android/app/.cxx/
